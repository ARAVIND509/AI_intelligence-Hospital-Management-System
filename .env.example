# ===================================================================
# MediMind AI — Production Environment Configuration (.env.example)
# ===================================================================

# Application Mode
ENVIRONMENT=production
DEBUG=false
APP_NAME=MediMind AI Hospital System
VERSION=1.0.0

# Host and Server Port
HOST=0.0.0.0
PORT=8000

# Security & JWT Token Authentication
# IMPORTANT: Generate a 64-character random string for production deployments
SECRET_KEY=medimind_prod_secret_key_change_in_production_2026_super_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL for Production, SQLite for Local Dev)
POSTGRES_DB=medimind_db
POSTGRES_USER=medimind_user
POSTGRES_PASSWORD=medimind_secure_password_2026
DATABASE_URL=postgresql://medimind_user:medimind_secure_password_2026@database:5432/medimind_db
# For SQLite local fallback:
# DATABASE_URL=sqlite:///./hospital.db

# Cache & Message Broker (Redis)
REDIS_URL=redis://redis:6379/0

# Allowed CORS Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost,https://127.0.0.1

# Production Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
